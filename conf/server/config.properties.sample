#Database connection. Uses environment variables for Docker deployment.
db.driver=org.postgresql.Driver
db.url=jdbc:postgresql://${DB_HOST}:5432/${DB_NAME}
db.user=${DB_USER}
db.password=${DB_PASSWORD}
db.query=select 1

#Mail configuration
mail.smtp.from=${EMAIL}
mail.smtp.host=${MAIL_HOST}
mail.smtp.port=${MAIL_PORT}
mail.smtp.auth=${MAIL_AUTH}
mail.smtp.username=${EMAIL}
mail.smtp.password=${MAIL_PASSWORD}
mail.smtp.starttls.enable=${MAIL_TLS}
